// ============================================================================
// LazyEnv - LazyEnv.rc.in
// Windows resource script: icon and version information
// Generated at CMake configure time — DO NOT EDIT the generated LazyEnv.rc.
// Version values come from project(LazyEnv VERSION ...) in CMakeLists.txt.
// ============================================================================

#include <winver.h>

// --- Application Icon ---
IDI_APPICON ICON "@CMAKE_CURRENT_SOURCE_DIR@/resources/lazyenv.ico"

// --- Version Information ---
VS_VERSION_INFO VERSIONINFO
    FILEVERSION    @LAZYENV_RC_VERSION@
    PRODUCTVERSION @LAZYENV_RC_VERSION@
    FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
    FILEFLAGS      0x0L
    FILEOS         VOS_NT_WINDOWS32
    FILETYPE       VFT_APP
    FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "LazyEnv Project"
            VALUE "FileDescription",  "LazyEnv - Development Environment Setup Tool"
            VALUE "FileVersion",      "@PROJECT_VERSION@"
            VALUE "InternalName",     "LazyEnv"
            VALUE "LegalCopyright",   "GPL-3.0"
            VALUE "OriginalFilename", "LazyEnv.exe"
            VALUE "ProductName",      "LazyEnv"
            VALUE "ProductVersion",   "@PROJECT_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
